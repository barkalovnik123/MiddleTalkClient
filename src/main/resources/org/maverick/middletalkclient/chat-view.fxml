<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="10.0" styleClass="base-container" stylesheets="@css/base.css, @css/code.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.maverick.middletalkclient.controllers.ChatController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <VBox alignment="CENTER" maxWidth="400.0" minWidth="300.0" prefWidth="300.0" spacing="20.0" HBox.hgrow="ALWAYS">

        <TextArea fx:id="messageArea" editable="false" prefHeight="300" prefWidth="400" styleClass="base-textarea" stylesheets="@css/base.css" VBox.vgrow="ALWAYS" />

        <Label fx:id="statusLabel" />

        <TextArea fx:id="input" maxHeight="100.0" styleClass="base-textarea" />

        <Button fx:id="sendButton" onAction="#onSendButton" styleClass="base-button">Send</Button>

    </VBox>
    <StackPane fx:id="editorContainer" minWidth="300.0" prefHeight="150.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
</HBox>
