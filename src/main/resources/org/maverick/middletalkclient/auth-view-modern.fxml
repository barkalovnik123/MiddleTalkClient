<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<BorderPane styleClass="base-container" stylesheets="@css/base.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.maverick.middletalkclient.controllers.AuthController">
   <center>
      <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="360.0" prefWidth="515.0">
         <HBox alignment="BOTTOM_LEFT" maxWidth="-Infinity" prefHeight="40.0" prefWidth="400.0">
            <Label styleClass="base-label" text="Username:" />
         </HBox>
         <TextField fx:id="usernameField" maxWidth="-Infinity" prefWidth="400.0" styleClass="base-input" />
         <HBox alignment="BOTTOM_LEFT" maxWidth="-Infinity" prefHeight="40.0" prefWidth="400.0">
            <Label styleClass="base-label" text="Password:" />
         </HBox>
         <TextField fx:id="passwordField" maxWidth="-Infinity" prefWidth="400.0" styleClass="base-input" />
         <Label fx:id="statusLabel" prefHeight="50.0" />
         <Button mnemonicParsing="false" onAction="#onAuthButtonClick" styleClass="base-button" text="Authorize" />
      </VBox>
   </center>
   <bottom>
       <ToolBar prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #0000;" BorderPane.alignment="CENTER">
           <padding>
               <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
           </padding>
           <Button onAction="#onCreateAccountButtonClick" mnemonicParsing="false" styleClass="base-button" text="Create an account"/>
       </ToolBar>
   </bottom>
</BorderPane>
