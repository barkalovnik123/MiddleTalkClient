<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" styleClass="base-container" stylesheets="@css/base.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.maverick.middletalkclient.controllers.RegController">
   <center>
      <VBox alignment="CENTER" maxWidth="350.0" prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
         <HBox alignment="BOTTOM_LEFT" prefHeight="40.0" prefWidth="200.0">
            <Label styleClass="base-label" text="Username:"/>
         </HBox>
         <TextField styleClass="base-input" fx:id="usernameField"/>
         <HBox alignment="BOTTOM_LEFT" prefHeight="40.0" prefWidth="200.0">
            <Label styleClass="base-label" text="Password:"/>
         </HBox>
         <PasswordField styleClass="base-input" fx:id="passwordField"/>
         <Label fx:id="statusLabel" textFill="WHITE">
            <padding>
               <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
         </Label>
         <Button mnemonicParsing="false" styleClass="base-button" text="Register" onAction="#onRegisterButtonClick"/>
      </VBox>
   </center>
   <bottom>
      <ToolBar prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #0000;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
         </padding>
         <Button mnemonicParsing="false" styleClass="base-button" text="← Назад"/>
      </ToolBar>
   </bottom>
</BorderPane>
